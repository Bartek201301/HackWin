{
  "name": "hackwin",
  "version": "0.1.0-pre.0",
  "description": "Workflow and CLI for hackathon teams of 2 to 4 people who each run their own coding agent sessions on one GitHub repository",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hackwin": "bin/hackwin.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bartek201301/HackWin.git"
  },
  "scripts": {
    "test": "tsc -p tsconfig.json && vitest run",
    "test:ac": "sh -c 'HACKWIN_TEST_IDS=\"$*\" exec vitest run --config vitest.ac.config.js' test:ac",
    "format": "prettier --write",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "picomatch": "4.0.7",
    "semver": "7.8.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
